# .env.example —— 复制为 .env 并填值。真实 .env 绝不入库（见 ../.gitignore）。
# 配置/密钥（中转站地址 / API Key / DB 口令 / LLM 地址）一律走环境变量，代码与镜像零硬编码。

# ---- PostgreSQL ----
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-in-real-env

# ---- 接入 API ----
DATABASE_URL=postgresql://platform:change-me-in-real-env@postgres:5432/platform
AUTH_TOKEN_SECRET=change-me-in-real-env

# ---- 后续阶段占位（本轮不用，勿硬编码到代码里）----
# RELAY_UPSTREAM_URL=        # 中转站地址（Phase 2，隔离在转发服务，可配置项）
# RECOMMEND_LLM_BASE_URL=    # AI 工具推荐用的 LLM 地址（Phase 4，待人工确认是否启用）
# RECOMMEND_LLM_API_KEY=
