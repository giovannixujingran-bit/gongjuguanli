# .env.example —— 复制为 .env 并填值。真实 .env 绝不入库（见 ../.gitignore）。
# 配置/密钥（中转站地址 / API Key / DB 口令 / LLM 地址）一律走环境变量，代码与镜像零硬编码。

# ---- PostgreSQL ----
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-in-real-env

# ---- 接入 API ----
DATABASE_URL=postgresql://platform:change-me-in-real-env@postgres:5432/platform
AUTH_TOKEN_SECRET=change-me-in-real-env

# ---- DB 连接行为 ----
# DB_CONNECT_TIMEOUT=5   # 连接 PostgreSQL 的超时秒数；DB 不可达时快速失败而非无限挂起。默认 5。

# ---- 本机 dev-run（scripts/serve.ps1 用；用 docker-compose 部署时不需要）----
# PLATFORM_PYTHON=         # 指定 python 解释器；离线/特殊环境填绝对路径，默认 python
# PLATFORM_HOST=127.0.0.1  # 接入 API 监听地址，默认 127.0.0.1
# PLATFORM_PORT=8000       # 接入 API 端口，默认 8000

# ---- 本机免安装 PostgreSQL（scripts/pg.ps1 用；用 docker-compose 起 PG 时不需要）----
# PG_BIN=D:\pg-portable\pgsql\bin   # 含 pg_ctl.exe / pg_isready.exe 的目录
# PG_DATA=D:\pg-portable\data       # PostgreSQL 数据目录

# ---- 后续阶段占位（本轮不用，勿硬编码到代码里）----
# RELAY_UPSTREAM_URL=        # 中转站地址（Phase 2，隔离在转发服务，可配置项）
# RECOMMEND_LLM_BASE_URL=    # AI 工具推荐用的 LLM 地址（Phase 4，待人工确认是否启用）
# RECOMMEND_LLM_API_KEY=
